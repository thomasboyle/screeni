<Window
    x:Class="Screeni.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Screeni.ViewModels"
    Title="Screeni">

    <Border Background="{StaticResource PageBackgroundBrush}"
            BorderBrush="{StaticResource FrameBrush}"
            BorderThickness="2">
        <Grid>
            <Grid Padding="26,18,26,16" RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="212" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Image Source="ms-appx:///Assets/Sprites/sprout.png"
                                   Width="30"
                                   Height="36"
                                   Stretch="Uniform"
                                   VerticalAlignment="Center" />
                            <TextBlock Text="Screeni" Style="{StaticResource DisplayTitleTextStyle}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.TodayTotalText, Mode=OneWay}"
                                   Style="{StaticResource MutedTextStyle}"
                                   FontSize="17"
                                   Margin="2,2,0,0" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource PixelButtonStyle}"
                            Click="SettingsButton_Click"
                            VerticalAlignment="Top"
                            Padding="14,7">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Image Source="ms-appx:///Assets/Sprites/gear.png"
                                   Width="17"
                                   Height="17"
                                   Stretch="Uniform"
                                   VerticalAlignment="Center" />
                            <TextBlock Text="Settings"
                                       FontFamily="{StaticResource PixelFont}"
                                       FontSize="16"
                                       Foreground="{StaticResource InkBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ToggleButton x:Name="DayToggle"
                                      Content="Day"
                                      Style="{StaticResource PixelToggleStyle}"
                                      Click="DayButton_Click" />
                        <ToggleButton x:Name="WeekToggle"
                                      Content="Week"
                                      Style="{StaticResource PixelToggleStyle}"
                                      Click="WeekButton_Click" />
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="{x:Bind ViewModel.RangeLabel, Mode=OneWay}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="20"
                               Foreground="{StaticResource InkMutedBrush}" />
                </Grid>

                <Border Grid.Row="2"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderSoftBrush}"
                        BorderThickness="2"
                        CornerRadius="6"
                        Padding="14,12">
                    <Grid>
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Bars, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout x:Name="ChartLayout"
                                                   Orientation="Horizontal"
                                                   MinItemWidth="6"
                                                   MinRowSpacing="0"
                                                   MinColumnSpacing="0"
                                                   MaximumRowsOrColumns="24"
                                                   ItemsStretch="Fill" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:ChartBar">
                                    <Grid ToolTipService.ToolTip="{x:Bind Tooltip}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="150" />
                                            <RowDefinition Height="9" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Rectangle VerticalAlignment="Bottom"
                                                   HorizontalAlignment="Center"
                                                   Width="{x:Bind BarWidth}"
                                                   Height="{x:Bind BarHeight}"
                                                   Fill="{StaticResource AccentBrush}" />

                                        <Image Grid.Row="1"
                                               Source="ms-appx:///Assets/Sprites/dash.png"
                                               Height="3"
                                               Stretch="Fill"
                                               VerticalAlignment="Center" />

                                        <TextBlock Grid.Row="2"
                                                   Text="{x:Bind Label}"
                                                   Style="{StaticResource AxisTextStyle}"
                                                   HorizontalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <Image Source="ms-appx:///Assets/Sprites/sprig.png"
                               Width="60"
                               Height="60"
                               Stretch="Uniform"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Margin="0,2,2,0" />
                    </Grid>
                </Border>

                <Grid Grid.Row="3" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel HorizontalAlignment="Left" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Image Source="ms-appx:///Assets/Sprites/leaf.png"
                                   Width="36"
                                   Height="32"
                                   Stretch="Uniform"
                                   VerticalAlignment="Center" />
                            <TextBlock Text="Apps"
                                       Style="{StaticResource SectionTitleTextStyle}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <Image Source="ms-appx:///Assets/Sprites/dash-soft.png"
                               Height="2"
                               Stretch="Fill" />
                    </StackPanel>

                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.Apps, Mode=OneWay}"
                              SelectionMode="None"
                              Background="Transparent"
                              Padding="0"
                              ItemContainerStyle="{StaticResource AppRowContainerStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:AppUsageItem">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Height="54" ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="42"
                                                Height="42"
                                                Background="{StaticResource AccentFillBrush}"
                                                BorderBrush="{StaticResource AccentBorderBrush}"
                                                BorderThickness="2"
                                                CornerRadius="5"
                                                VerticalAlignment="Center">
                                            <Grid>
                                                <Image Source="{x:Bind Icon}"
                                                       Visibility="{x:Bind IconVisibility}"
                                                       Width="24"
                                                       Height="24"
                                                       Stretch="Uniform" />
                                                <TextBlock Text="{x:Bind Initial}"
                                                           Visibility="{x:Bind InitialVisibility}"
                                                           FontFamily="{StaticResource PixelFont}"
                                                           FontSize="20"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource InkBrush}" />
                                            </Grid>
                                        </Border>

                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind Name}"
                                                   FontFamily="{StaticResource PixelFont}"
                                                   FontSize="16"
                                                   Foreground="{StaticResource InkBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="320" />

                                        <ProgressBar Grid.Column="2"
                                                     Style="{StaticResource PixelBarStyle}"
                                                     Value="{x:Bind Share}"
                                                     Margin="0,0,14,0" />

                                        <TextBlock Grid.Column="3"
                                                   Text="{x:Bind DurationText}"
                                                   Style="{StaticResource MutedTextStyle}"
                                                   FontSize="16"
                                                   MinWidth="58"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Center" />
                                    </Grid>

                                    <Image Grid.Row="1"
                                           Source="ms-appx:///Assets/Sprites/dash-soft.png"
                                           Height="2"
                                           Stretch="Fill" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>

            <Grid x:Name="SettingsOverlay"
                  Visibility="Collapsed"
                  Background="#7A4A452F"
                  Tapped="SettingsScrim_Tapped">
                <Border Width="340"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,74,26,0"
                        Padding="20,18"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderStrongBrush}"
                        BorderThickness="2"
                        CornerRadius="4">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Settings" Style="{StaticResource SectionTitleTextStyle}" />
                        <Image Source="ms-appx:///Assets/Sprites/dash-soft.png"
                               Height="2"
                               Stretch="Fill" />

                        <CheckBox Content="Start with Windows"
                                  Style="{StaticResource PixelCheckBoxStyle}"
                                  IsChecked="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" />

                        <TextBlock Text="Idle pause (seconds)" Style="{StaticResource MutedTextStyle}" />

                        <NumberBox Value="{x:Bind ViewModel.IdleThresholdSec, Mode=TwoWay}"
                                   Minimum="15"
                                   Maximum="3600"
                                   FontFamily="{StaticResource PixelFont}"
                                   SpinButtonPlacementMode="Inline" />

                        <Button Content="Apply"
                                Style="{StaticResource PixelButtonStyle}"
                                Click="ApplySettings_Click"
                                HorizontalAlignment="Stretch" />

                        <Button Content="Clear usage data"
                                Style="{StaticResource PixelButtonStyle}"
                                Click="ClearData_Click"
                                HorizontalAlignment="Stretch" />

                        <Button Content="Close"
                                Style="{StaticResource PixelButtonStyle}"
                                Click="CloseSettings_Click"
                                HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
