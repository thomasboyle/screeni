<Application
    x:Class="Screeni.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="AppFont">Segoe UI Variable Text</FontFamily>
            <FontFamily x:Key="PixelFont">Segoe UI Variable Text</FontFamily>

            <SolidColorBrush x:Key="PageBackgroundBrush" Color="#FCFBF6" />
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#F8F8F0" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFDF9" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#F3F4E9" />
            <SolidColorBrush x:Key="SurfacePressedBrush" Color="#E9EBD8" />
            <SolidColorBrush x:Key="FrameBrush" Color="#DEDCCF" />
            <SolidColorBrush x:Key="InkBrush" Color="#34412D" />
            <SolidColorBrush x:Key="InkMutedBrush" Color="#7B806F" />
            <SolidColorBrush x:Key="BorderSoftBrush" Color="#E4E2D7" />
            <SolidColorBrush x:Key="BorderStrongBrush" Color="#C9CBB8" />
            <SolidColorBrush x:Key="AccentBrush" Color="#9AA574" />
            <SolidColorBrush x:Key="AccentFillBrush" Color="#E8E9D6" />
            <SolidColorBrush x:Key="AccentFillHoverBrush" Color="#DDE1C6" />
            <SolidColorBrush x:Key="AccentBorderBrush" Color="#899563" />
            <SolidColorBrush x:Key="DashBrush" Color="#A7AF85" />
            <SolidColorBrush x:Key="DashSoftBrush" Color="#E2E2D6" />
            <SolidColorBrush x:Key="PlantLightBrush" Color="#D7DEC0" />
            <SolidColorBrush x:Key="PlantMidBrush" Color="#B9C695" />
            <SolidColorBrush x:Key="PlantDarkBrush" Color="#9DAC75" />

            <Style x:Key="BodyTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            </Style>

            <Style x:Key="DisplayTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            </Style>

            <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            </Style>

            <Style x:Key="MutedTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
            </Style>

            <Style x:Key="AxisTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
            </Style>

            <Style x:Key="PixelButtonStyle" TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Shell.Background" Value="{StaticResource SurfaceHoverBrush}" />
                                                <Setter Target="Shell.BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Shell.Background" Value="{StaticResource SurfacePressedBrush}" />
                                                <Setter Target="Shell.BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Presenter.Opacity" Value="0.45" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Border x:Name="Shell"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderSoftBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                    <ContentPresenter x:Name="Presenter"
                                                      Padding="{TemplateBinding Padding}"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Segmented range selector: filled sage when checked, cream when not. -->
            <Style x:Key="PixelToggleStyle" TargetType="ToggleButton">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                <Setter Property="Padding" Value="12,5" />
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Shell.Background" Value="{StaticResource SurfaceHoverBrush}" />
                                                <Setter Target="Shell.BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Shell.Background" Value="{StaticResource SurfacePressedBrush}" />
                                                <Setter Target="Shell.BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="Shell.Background" Value="{StaticResource AccentFillBrush}" />
                                                <Setter Target="Shell.BorderBrush" Value="{StaticResource AccentBorderBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Shell.Background" Value="{StaticResource AccentFillHoverBrush}" />
                                                <Setter Target="Shell.BorderBrush" Value="{StaticResource AccentBorderBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPressed">
                                            <VisualState.Setters>
                                                <Setter Target="Shell.Background" Value="{StaticResource AccentFillHoverBrush}" />
                                                <Setter Target="Shell.BorderBrush" Value="{StaticResource AccentBorderBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Presenter.Opacity" Value="0.45" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Border x:Name="Shell"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderSoftBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <ContentPresenter x:Name="Presenter"
                                                      Padding="{TemplateBinding Padding}"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="NavButtonStyle" TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Shell.Background" Value="{StaticResource SurfaceHoverBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Shell.Background" Value="{StaticResource SurfacePressedBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Border x:Name="Shell"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="8">
                                    <ContentPresenter Padding="{TemplateBinding Padding}"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AppRowContainerStyle" TargetType="ListViewItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Style>

            <Style x:Key="PixelBarStyle" TargetType="ProgressBar">
                <Setter Property="Height" Value="4" />
                <Setter Property="Minimum" Value="0" />
                <Setter Property="Maximum" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="PixelCheckBoxStyle" TargetType="CheckBox">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid ColumnSpacing="10" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CombinedStates">
                                        <VisualState x:Name="UncheckedNormal" />
                                        <VisualState x:Name="UncheckedPointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Box.BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="UncheckedPressed">
                                            <VisualState.Setters>
                                                <Setter Target="Box.Background" Value="{StaticResource SurfacePressedBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedNormal">
                                            <VisualState.Setters>
                                                <Setter Target="Box.BorderBrush" Value="{StaticResource AccentBorderBrush}" />
                                                <Setter Target="Tick.Visibility" Value="Visible" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Box.BorderBrush" Value="{StaticResource AccentBorderBrush}" />
                                                <Setter Target="Box.Background" Value="{StaticResource SurfaceHoverBrush}" />
                                                <Setter Target="Tick.Visibility" Value="Visible" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPressed">
                                            <VisualState.Setters>
                                                <Setter Target="Box.BorderBrush" Value="{StaticResource AccentBorderBrush}" />
                                                <Setter Target="Tick.Visibility" Value="Visible" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Border x:Name="Box"
                                        Width="20"
                                        Height="20"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderSoftBrush}"
                                        BorderThickness="2"
                                        CornerRadius="2"
                                        VerticalAlignment="Center">
                                    <Rectangle x:Name="Tick"
                                               Width="8"
                                               Height="8"
                                               Fill="{StaticResource AccentBrush}"
                                               Visibility="Collapsed" />
                                </Border>

                                <ContentPresenter Grid.Column="1"
                                                  Content="{TemplateBinding Content}"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
