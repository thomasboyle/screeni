<Application
    x:Class="Screeni.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="PixelFont">ms-appx:///Assets/Fonts/Monocraft.ttf#Monocraft</FontFamily>

            <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F7EFDC" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FCF5E8" />
            <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#F2E9D3" />
            <SolidColorBrush x:Key="SurfacePressedBrush" Color="#EADFC5" />
            <SolidColorBrush x:Key="FrameBrush" Color="#A79A86" />
            <SolidColorBrush x:Key="InkBrush" Color="#474E2F" />
            <SolidColorBrush x:Key="InkMutedBrush" Color="#6C7052" />
            <SolidColorBrush x:Key="BorderSoftBrush" Color="#BEB6A2" />
            <SolidColorBrush x:Key="BorderStrongBrush" Color="#8A8C6B" />
            <SolidColorBrush x:Key="AccentBrush" Color="#A0A773" />
            <SolidColorBrush x:Key="AccentFillBrush" Color="#C1C79E" />
            <SolidColorBrush x:Key="AccentFillHoverBrush" Color="#B6BD92" />
            <SolidColorBrush x:Key="AccentBorderBrush" Color="#7E8A5C" />
            <SolidColorBrush x:Key="DashBrush" Color="#98A075" />
            <SolidColorBrush x:Key="DashSoftBrush" Color="#C7C0AA" />

            <x:Double x:Key="PixelBorderThickness">2</x:Double>

            <Style x:Key="BodyTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            </Style>

            <Style x:Key="DisplayTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
                <Setter Property="FontSize" Value="46" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                <Setter Property="LineHeight" Value="50" />
            </Style>

            <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            </Style>

            <Style x:Key="MutedTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
            </Style>

            <Style x:Key="AxisTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
            </Style>

            <!-- Chunky bordered button with a flat pixel silhouette. -->
            <Style x:Key="PixelButtonStyle" TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                <Setter Property="Padding" Value="14,6" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Shell.Background" Value="{StaticResource SurfaceHoverBrush}" />
                                                <Setter Target="Shell.BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Shell.Background" Value="{StaticResource SurfacePressedBrush}" />
                                                <Setter Target="Shell.BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Presenter.Opacity" Value="0.45" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Border x:Name="Shell"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderSoftBrush}"
                                        BorderThickness="2"
                                        CornerRadius="3">
                                    <ContentPresenter x:Name="Presenter"
                                                      Padding="{TemplateBinding Padding}"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Segmented range selector: filled sage when checked, cream when not. -->
            <Style x:Key="PixelToggleStyle" TargetType="ToggleButton">
                <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                <Setter Property="Padding" Value="18,5" />
                <Setter Property="MinWidth" Value="112" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Shell.Background" Value="{StaticResource SurfaceHoverBrush}" />
                                                <Setter Target="Shell.BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Shell.Background" Value="{StaticResource SurfacePressedBrush}" />
                                                <Setter Target="Shell.BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="Shell.Background" Value="{StaticResource AccentFillBrush}" />
                                                <Setter Target="Shell.BorderBrush" Value="{StaticResource AccentBorderBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Shell.Background" Value="{StaticResource AccentFillHoverBrush}" />
                                                <Setter Target="Shell.BorderBrush" Value="{StaticResource AccentBorderBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPressed">
                                            <VisualState.Setters>
                                                <Setter Target="Shell.Background" Value="{StaticResource AccentFillHoverBrush}" />
                                                <Setter Target="Shell.BorderBrush" Value="{StaticResource AccentBorderBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Presenter.Opacity" Value="0.45" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Border x:Name="Shell"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderSoftBrush}"
                                        BorderThickness="2"
                                        CornerRadius="3">
                                    <ContentPresenter x:Name="Presenter"
                                                      Padding="{TemplateBinding Padding}"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AppRowContainerStyle" TargetType="ListViewItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Style>

            <!-- Flat usage bar: no track, square ends, sage fill. -->
            <Style x:Key="PixelBarStyle" TargetType="ProgressBar">
                <Setter Property="Height" Value="9" />
                <Setter Property="Minimum" Value="0" />
                <Setter Property="Maximum" Value="1" />
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="PixelCheckBoxStyle" TargetType="CheckBox">
                <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid ColumnSpacing="10" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CombinedStates">
                                        <VisualState x:Name="UncheckedNormal" />
                                        <VisualState x:Name="UncheckedPointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Box.BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="UncheckedPressed">
                                            <VisualState.Setters>
                                                <Setter Target="Box.Background" Value="{StaticResource SurfacePressedBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedNormal">
                                            <VisualState.Setters>
                                                <Setter Target="Box.BorderBrush" Value="{StaticResource AccentBorderBrush}" />
                                                <Setter Target="Tick.Visibility" Value="Visible" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Box.BorderBrush" Value="{StaticResource AccentBorderBrush}" />
                                                <Setter Target="Box.Background" Value="{StaticResource SurfaceHoverBrush}" />
                                                <Setter Target="Tick.Visibility" Value="Visible" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPressed">
                                            <VisualState.Setters>
                                                <Setter Target="Box.BorderBrush" Value="{StaticResource AccentBorderBrush}" />
                                                <Setter Target="Tick.Visibility" Value="Visible" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Border x:Name="Box"
                                        Width="20"
                                        Height="20"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderSoftBrush}"
                                        BorderThickness="2"
                                        CornerRadius="2"
                                        VerticalAlignment="Center">
                                    <Rectangle x:Name="Tick"
                                               Width="8"
                                               Height="8"
                                               Fill="{StaticResource AccentBrush}"
                                               Visibility="Collapsed" />
                                </Border>

                                <ContentPresenter Grid.Column="1"
                                                  Content="{TemplateBinding Content}"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
