<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <WindowsSdkVersion>10.0.26100.0</WindowsSdkVersion>
    <RootNamespace>Screeni</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <WindowsAppSdkBootstrapInitialize>true</WindowsAppSdkBootstrapInitialize>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <EnableCoreMrtTooling>false</EnableCoreMrtTooling>
    <AppxPackage>false</AppxPackage>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <AppxGeneratePrisForPortableLibrariesEnabled>false</AppxGeneratePrisForPortableLibrariesEnabled>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>Assets\Screeni.ico</ApplicationIcon>
    <DefineConstants>DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.3.1" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250205002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Screeni.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Fonts\*.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Sprites\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyXamlBinaries" AfterTargets="Build">
    <ItemGroup>
      <_XamlBinaries Include="$(IntermediateOutputPath)*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(_XamlBinaries)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="'@(_XamlBinaries)' != ''" />
  </Target>

  <Target Name="GenerateAppResourcesPri" AfterTargets="CopyXamlBinaries">
    <PropertyGroup>
      <_MakePri>$(MSBuildThisFileDirectory)..\..\scripts\makepri-path.txt</_MakePri>
      <_PriStage>$(IntermediateOutputPath)pri-stage</_PriStage>
      <_MakePriExe>C:\Program Files (x86)\Windows Kits\10\bin\10.0.26100.0\x64\makepri.exe</_MakePriExe>
    </PropertyGroup>
    <MakeDir Directories="$(_PriStage)" />
    <!-- Unpackaged WinUI resolves ms-appx assets through resources.pri, so fonts and sprites must be indexed. -->
    <Copy SourceFiles="Assets\Fonts\Monocraft.ttf;Assets\Fonts\Monocraft-Bold.ttf" DestinationFolder="$(_PriStage)\Assets\Fonts" SkipUnchangedFiles="true" />
    <Copy SourceFiles="Assets\Sprites\sprout.png;Assets\Sprites\leaf.png;Assets\Sprites\sprig.png;Assets\Sprites\gear.png;Assets\Sprites\dash.png;Assets\Sprites\dash-soft.png" DestinationFolder="$(_PriStage)\Assets\Sprites" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(IntermediateOutputPath)App.xbf" DestinationFiles="$(_PriStage)\App.xaml" Condition="Exists('$(IntermediateOutputPath)App.xbf')" />
    <Copy SourceFiles="$(IntermediateOutputPath)MainWindow.xbf" DestinationFiles="$(_PriStage)\MainWindow.xaml" Condition="Exists('$(IntermediateOutputPath)MainWindow.xbf')" />
    <WriteLinesToFile File="$(_PriStage)\priconfig.xml" Overwrite="true" Lines="&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;;&lt;resources targetOsVersion=&quot;10.0.0&quot; majorVersion=&quot;1&quot;&gt;;&lt;index root=&quot;\&quot; startIndexAt=&quot;\&quot;&gt;;&lt;default&gt;&lt;qualifier name=&quot;Language&quot; value=&quot;en-US&quot;/&gt;&lt;/default&gt;;&lt;indexer-config type=&quot;folder&quot; foldernameAsQualifier=&quot;true&quot; filenameAsQualifier=&quot;true&quot; qualifierDelimiter=&quot;.&quot;/&gt;;&lt;/index&gt;;&lt;/resources&gt;" />
    <Exec Command="&quot;$(_MakePriExe)&quot; new /pr &quot;$(_PriStage)&quot; /cf &quot;$(_PriStage)\priconfig.xml&quot; /of &quot;$(OutDir)resources.pri&quot; /o" Condition="Exists('$(_MakePriExe)') And Exists('$(_PriStage)\App.xaml')" />
  </Target>

  <Target Name="CopyXamlBinariesOnPublish" AfterTargets="Publish">
    <ItemGroup>
      <_XamlBinaries Include="$(IntermediateOutputPath)*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(_XamlBinaries)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="'@(_XamlBinaries)' != ''" />
    <Copy SourceFiles="$(OutDir)resources.pri" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="Exists('$(OutDir)resources.pri')" />
  </Target>

  <Target Name="CopyScreeniCore" AfterTargets="Build">
    <PropertyGroup>
      <_CoreDll>$(MSBuildThisFileDirectory)..\..\build\Screeni.Core\bin\Release\Screeni.Core.dll</_CoreDll>
      <_CoreDllAlt>$(MSBuildThisFileDirectory)..\..\build\Screeni.Core\Release\Screeni.Core.dll</_CoreDllAlt>
    </PropertyGroup>
    <Copy SourceFiles="$(_CoreDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('$(_CoreDll)')" />
    <Copy SourceFiles="$(_CoreDllAlt)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="!Exists('$(_CoreDll)') And Exists('$(_CoreDllAlt)')" />
  </Target>

  <Target Name="CopyScreeniCoreOnPublish" AfterTargets="Publish">
    <PropertyGroup>
      <_CoreDll>$(MSBuildThisFileDirectory)..\..\build\Screeni.Core\bin\Release\Screeni.Core.dll</_CoreDll>
      <_CoreDllAlt>$(MSBuildThisFileDirectory)..\..\build\Screeni.Core\Release\Screeni.Core.dll</_CoreDllAlt>
    </PropertyGroup>
    <Copy SourceFiles="$(_CoreDll)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="Exists('$(_CoreDll)')" />
    <Copy SourceFiles="$(_CoreDllAlt)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="!Exists('$(_CoreDll)') And Exists('$(_CoreDllAlt)')" />
  </Target>
</Project>
